# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# AirRajasthan™ Backend & Database Configuration
# (Server-only — NEVER prefix with VITE_ to keep credentials out of client bundles)
# ==============================================================================
NODE_ENV="development"
PORT="3000"

# MySQL Database Connection Settings
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="air_rajasthan"
DB_USER="air_rajasthan_user"
DB_PASSWORD="your_secure_mysql_password_here"
DB_CONNECTION_LIMIT="10"

# Server Session Security
SESSION_SECRET="generate_a_secure_random_session_secret_at_least_32_chars_long"

# Application Origin (for CSRF verification and cookie origin)
APP_ORIGIN="http://localhost:3000"

# Centralized WhatsApp Contact Configuration (digits only, no spaces or +)
WHATSAPP_PHONE="971509085541"

# One-time First Administrator Setup (for running server/scripts/create-admin.ts)
INITIAL_ADMIN_EMAIL="admin@airrajasthan.com"
INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_PASSWORD="change_me_to_a_secure_temporary_password"
